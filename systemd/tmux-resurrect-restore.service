[Unit]
Description=Restore tmux session from tmux-resurrect save at boot
After=default.target

[Service]
Type=oneshot
# the tmux server started by the restore lives in this unit's cgroup — never let systemd kill it when the oneshot finishes
KillMode=process
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/tmux-restore-if-empty

[Install]
WantedBy=default.target
