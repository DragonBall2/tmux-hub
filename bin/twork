#!/usr/bin/env bash
# twork — one git worktree per task, one tmux window per worktree
#
#   twork new  <branch> [--from <ref>] [--no-claude]   create ../<repo>-wt/<branch> (+ branch), run the repo's
#                                                      .worktree-setup.sh if present, open a tmux window there,
#                                                      start `claude` in it (unless --no-claude / no claude)
#   twork open <branch>                                open (or jump to) the tmux window of an existing worktree
#   twork ls                                           worktrees + their tmux windows
#   twork drop <branch> [--force]                      refuse if dirty or unmerged (unless --force); kill the
#                                                      window, remove the worktree, delete the branch if merged
#   twork prompt                                       ask for a branch name (used by the sidebar's Ctrl+W)
#
# Run it inside the repository (or set TMUX_BASE_DIR to the main checkout). Worktrees live next to the repo:
# <parent>/<repo name>-wt/<branch>  (override with TWORK_ROOT). Settings: ~/.config/tmux-hub/env
[ -f "$HOME/.config/tmux-hub/env" ] && . "$HOME/.config/tmux-hub/env"
set -euo pipefail
case "${TMUX:-}" in */hub,*) unset TMUX;; esac   # called from the sidebar (outer hub server): talk to the default server
BASE="${TMUX_BASE_SESSION:-main}"
case "${TMUX_HUB_LANG:-${LANG:-}}" in ko*) L=ko;; *) L=en;; esac
t() { if [ "$L" = ko ]; then printf '%s\n' "$1"; else printf '%s\n' "$2"; fi; }
die() { t "$1" "$2" >&2; exit 1; }

repo_root() {
  local r; r="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  [ -z "$r" ] && [ -n "${TMUX_BASE_DIR:-}" ] && r="$(git -C "$TMUX_BASE_DIR" rev-parse --show-toplevel 2>/dev/null || true)"
  [ -n "$r" ] || die "git 저장소 안에서 실행하거나 TMUX_BASE_DIR 를 설정하세요" "run inside a git repo or set TMUX_BASE_DIR"
  # if we are inside a worktree, use the main checkout (first entry)
  git -C "$r" worktree list --porcelain | sed -n '1s/^worktree //p'
}
MAIN="$(repo_root)"; NAME="$(basename "$MAIN")"
ROOT="${TWORK_ROOT:-$(dirname "$MAIN")/$NAME-wt}"
wt_path() { printf '%s/%s' "$ROOT" "$(printf '%s' "$1" | tr '/' '-')"; }
win_of() { # window id whose pane cwd is inside the worktree
  local p="$1"; tmux list-panes -s -t "$BASE" -F '#{window_id} #{pane_current_path}' 2>/dev/null | awk -v p="$p" 'index($2,p)==1{print $1; exit}'
}
open_window() { # $1 path, $2 branch, $3 start claude (1/0)
  local w; w="$(win_of "$1")"
  if [ -z "$w" ]; then
    w="$(tmux new-window -d -P -F '#{window_id}' -t "$BASE" -c "$1")"
    tmux rename-window -t "$BASE:$w" "wt:$2"
    if [ "$3" = 1 ] && command -v claude >/dev/null 2>&1; then
      tmux set -w -t "$BASE:$w" automatic-rename on      # let the Claude session name take over
      tmux send-keys -t "$BASE:$w" "claude" Enter
    fi                                                   # plain shell: keep the "wt:<branch>" name
  fi
  # show it in the hub tab (if called from the sidebar) or in the base session
  tmux select-window -t "${HUB_SESSION:-$BASE}:$w" 2>/dev/null || true
}

cmd="${1:-ls}"; shift || true
case "$cmd" in
  new)
    br="${1:-}"; [ -n "$br" ] || die "브랜치 이름이 필요합니다: twork new <branch>" "branch name required: twork new <branch>"; shift
    from=""; claude=1
    while [ $# -gt 0 ]; do case "$1" in --from) from="$2"; shift 2;; --no-claude) claude=0; shift;; *) die "알 수 없는 옵션: $1" "unknown option: $1";; esac; done
    p="$(wt_path "$br")"; mkdir -p "$ROOT"
    if [ -d "$p" ]; then t "이미 있음: $p — 창만 엽니다" "exists: $p — opening its window"
    else
      t "▶ worktree 생성 중 (큰 저장소는 수십 초 걸릴 수 있음)…" "▶ creating worktree (large repos can take a while)…"
      if git -C "$MAIN" show-ref --verify --quiet "refs/heads/$br"; then git -C "$MAIN" worktree add "$p" "$br"
      else git -C "$MAIN" worktree add -b "$br" "$p" ${from:+"$from"}; fi
      if [ -x "$MAIN/.worktree-setup.sh" ]; then
        t "▶ .worktree-setup.sh 실행" "▶ running .worktree-setup.sh"
        "$MAIN/.worktree-setup.sh" "$MAIN" "$p" || t "  ⚠ setup 스크립트 실패(계속 진행)" "  ⚠ setup script failed (continuing)"
      fi
    fi
    open_window "$p" "$br" "$claude"; t "✓ $p" "✓ $p";;
  open)
    br="${1:-}"; [ -n "$br" ] || die "twork open <branch>" "twork open <branch>"; p="$(wt_path "$br")"; [ -d "$p" ] || die "worktree 없음: $p" "no worktree: $p"
    open_window "$p" "$br" 0;;
  ls)
    git -C "$MAIN" worktree list --porcelain | awk '/^worktree /{p=$2} /^branch /{b=$2; sub("refs/heads/","",b); print p "\t" b} /^detached/{print p "\t(detached)"}' | while IFS=$'\t' read -r p b; do
      w="$(win_of "$p")"; dirty=""; [ -n "$(git -C "$p" status --porcelain 2>/dev/null | head -1)" ] && dirty="  *uncommitted"
      printf '%-28s %-6s %s%s\n' "$b" "${w:--}" "$p" "$dirty"; done;;
  drop)
    br="${1:-}"; [ -n "$br" ] || die "twork drop <branch> [--force]" "twork drop <branch> [--force]"; force=0; [ "${2:-}" = "--force" ] && force=1
    p="$(wt_path "$br")"; [ -d "$p" ] || die "worktree 없음: $p" "no worktree: $p"
    if [ "$force" = 0 ]; then
      [ -z "$(git -C "$p" status --porcelain | head -1)" ] || die "커밋 안 된 변경이 있습니다: $p (--force 로 강제)" "uncommitted changes in $p (use --force)"
      main_br="$(git -C "$MAIN" branch --show-current)"
      git -C "$MAIN" merge-base --is-ancestor "$br" "$main_br" 2>/dev/null || die "브랜치 '$br' 가 $main_br 에 머지되지 않았습니다 (--force 로 강제)" "branch '$br' is not merged into $main_br (use --force)"
    fi
    if [ "$force" = 1 ]; then git -C "$MAIN" worktree remove --force --force "$p"; else git -C "$MAIN" worktree remove "$p"; fi
    w="$(win_of "$p")"; [ -n "$w" ] && tmux kill-window -t "$BASE:$w"   # only after the worktree is really gone
    git -C "$MAIN" branch -d "$br" 2>/dev/null || t "  (브랜치 '$br' 는 남겨둠 — 미머지)" "  (branch '$br' kept — not merged)"
    t "✓ 제거: $p" "✓ removed: $p";;
  prompt)
    printf '\033[2J\033[H'
    if [ "$L" = ko ]; then printf '\n  새 worktree 브랜치 이름 (빈 값 = 취소): '; else printf '\n  new worktree branch name (empty = cancel): '; fi
    IFS= read -r br || true; [ -n "${br:-}" ] || exit 0
    cd "${TMUX_BASE_DIR:-$MAIN}" && exec "$0" new "$br";;
  *) sed -n '2,15p' "$0"; exit 1;;
esac
